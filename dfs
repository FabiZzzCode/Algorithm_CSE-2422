#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> adj;
vector<int> visited;

void dfs(int node) {
    visited[node] = 1;
    cout << node << " ";

    for (int next : adj[node]) {
        if (!visited[next]) {
            dfs(next);
        }
    }
}

int main() {
    int n, m;
    cout << "Enter number of nodes: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> m;

    adj.resize(n + 1);
    visited.assign(n + 1, 0);

    cout << "Enter edges (u v):\n";
    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    int start;
    cout << "Enter starting node for DFS: ";
    cin >> start;

    cout << "DFS Traversal: ";
    dfs(start);

    cout << endl;
    return 0;
}
