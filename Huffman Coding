#include <bits/stdc++.h>
using namespace std;

class Node {
public:
    char ch;
    int freq;
    Node *left, *right;
    Node(char c, int f) {
        ch = c;
        freq = f;
        left = right = nullptr;
    }
};

class Compare {
public:
    bool operator()(Node* a, Node* b) {
        return a->freq > b->freq;
    }
};

void generateCodes(Node* root, string curr, unordered_map<char,string> &codes) {
    if (root == nullptr) return;

    if (root->left == nullptr && root->right == nullptr) {
        codes[root->ch] = curr;
        return;
    }
    generateCodes(root->left, curr + "0", codes);
    generateCodes(root->right, curr + "1", codes);
}

int main() {
    string msg;
    cout << "Enter your message: ";
    getline(cin, msg);

    unordered_map<char, int> freq;
    for (char c : msg) freq[c]++;

    priority_queue<Node*, vector<Node*>, Compare> pq;

    for (auto &p : freq)
        pq.push(new Node(p.first, p.second));

    while (pq.size() >= 2) {
        Node* left = pq.top(); pq.pop();
        Node* right = pq.top(); pq.pop();

        Node* merged = new Node('\0', left->freq + right->freq);
        merged->left = left;
        merged->right = right;

        pq.push(merged);
    }

    Node* root = pq.top();

    unordered_map<char,string> codes;
    generateCodes(root, "", codes);

    string encoded = "";
    for (char c : msg) {
        encoded += codes[c];
    }

    int originalBits = msg.length() * 8;
    int compressedBits = encoded.length();
    int savedBits = originalBits - compressedBits;

    cout << "\nHuffman Codes:\n";
    for (auto &p : codes)
        cout << p.first << " : " << p.second << "\n";

    cout << "\nEncoded Message:\n" << encoded << "\n";

    cout << "\n-----------------------------\n";
    cout << "Original Size    : " << originalBits << " bits\n";
    cout << "Compressed Size  : " << compressedBits << " bits\n";
    cout << "Bit Reduction    : " << savedBits << " bits\n";
    cout << "-----------------------------\n";

    return 0;
}
