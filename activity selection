
#include<bits/stdc++.h>
using namespace std;

int main(){
    int n;
    cout<< "Enter number of activities: ";
    cin>>n;

    vector<pair<int,int>>arr;

    cout<<"Enter start and finish time:"<<endl;

    for(int i=0;i<n;i++){
        int s,f;
        cin>>s>>f;

        arr.push_back({f,s});
    }

    sort(arr.begin(),arr.end());

    cout<<endl<<"Selected activities:"<<endl;

    cout<<"("<<arr[0].second<<","<<arr[0].first<<")"<<endl;

    int lastF=arr[0].first;

    for(int i=1;i<n;i++){
        int start=arr[i].second;
        int finish=arr[i].first;

        if(start>=lastF){
            cout<<"("<<start<<","<<finish<<")"<<endl;
            lastF=finish;
        }
    }

    return 0;

}
